# Application Config
PORT=3000
NODE_ENV=development

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION EXAMPLES
# Choose one of the database connection configurations below and set DATABASE_URL.
# Make sure to update the provider in prisma/schema.prisma datasource block if you change the database type.
# -----------------------------------------------------------------------------

# --- 1. PostgreSQL (Local or Remote) ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=schema_name
# Example:
# DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/my_database?schema=public"

# --- 2. MySQL ---
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# Note: If there is no password, omit the colon before the '@' (e.g. mysql://root@localhost:3306/my_database)
# Example (with password):
# DATABASE_URL="mysql://root:mysqlpassword@localhost:3306/my_database"
# Example (no password):
# DATABASE_URL="mysql://root@localhost:3306/my_database"

# --- 3. Supabase (PostgreSQL) ---
# Supabase uses connection pooling. It is recommended to use the transaction pooler (port 6543) for Prisma query engine,
# and specify ?pgbouncer=true at the end. For migrations (prisma migrate), you can use the direct connection (port 5432).
#
# Transaction connection string (default for app queries):
# DATABASE_URL="postgresql://postgres.yourprojectid:yourpassword@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
#
# Direct connection string (used for prisma migrate):
# DIRECT_URL="postgresql://postgres.yourprojectid:yourpassword@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# Active Database Connection String (Replace with your actual database URL)
DATABASE_URL="mysql://root@localhost:3306/test"

# --- JWT Authentication ---
JWT_SECRET="generate_a_long_random_string_for_production"
JWT_EXPIRES_IN="1d"
